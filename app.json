{
  "expo": {
    "name": "Bero Tasker",
    "slug": "bero-tasker",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bero-tasker",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.berotasker"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f4f7fa",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "versionCode": 3,
      "package": "com.ibrahim.berotasker",
      "supportsRTL": false,
      "buildType": "release",
      "extraPackagerArgs": [
        "--minify"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": {
            "scheme": "bero-tasker",
            "host": "tasks"
          },
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "clerkPublishableKey": "pk_test_YXdhcmUtd2VyZXdvbGYtNDAuY2xlcmsuYWNjb3VudHMuZGV2JA",
      "router": {},
      "eas": {
        "projectId": "17b4fa45-8796-44f5-bdf7-fbc82f1758ae"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#f4f7fa"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}